# Values for the web build (expo export, `pnpm deploy:web`). Both are public, so this file is committed.
# Local dev values belong in .env.development, never here or in .env. See DEPLOY.md step 2.
EXPO_PUBLIC_API_URL=https://api.chatsoon.app
# Cloudflare Turnstile site key for chatsoon.app (DEPLOY.md step 4). The web build fails until this is replaced.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAFBnosWbo7DpF_Z-
