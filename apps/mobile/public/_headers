# Cloudflare Pages response headers for chatsoon.app.
# No Content-Security-Policy on purpose: Turnstile on the Connect form loads scripts and an iframe
# from challenges.cloudflare.com, and the API lives on api.chatsoon.app.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=()

# Universal links: Apple requires JSON for this extensionless file.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Public profiles are for the people you share them with, not search results. The page sets a
# robots meta tag too, but only crawlers that run JavaScript see that.
/id/*
  X-Robots-Tag: noindex

# Signed-in-only app routes. robots.txt already disallows crawling these, but this header is a
# stronger signal for a route that gets crawled anyway (a stray link, a redirect), since the SPA
# shell it serves has no real content for a crawler that doesn't run JavaScript.
/sign-in
  X-Robots-Tag: noindex

/onboarding
  X-Robots-Tag: noindex

/contacts
  X-Robots-Tag: noindex

/contact/*
  X-Robots-Tag: noindex

/add
  X-Robots-Tag: noindex

/qr
  X-Robots-Tag: noindex

/me
  X-Robots-Tag: noindex

/scan
  X-Robots-Tag: noindex

/card
  X-Robots-Tag: noindex

/card-review/*
  X-Robots-Tag: noindex

/tags
  X-Robots-Tag: noindex

/profile-edit
  X-Robots-Tag: noindex

/llms.txt
  Cache-Control: public, max-age=3600

# Hashed bundles from `expo export` never change.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable

# Share-preview images carry a content hash in the filename (O5, docs/og-plan.md) and a new one is
# never reused for different bytes, so they can be cached forever too.
/og/*
  Cache-Control: public, max-age=31536000, immutable
