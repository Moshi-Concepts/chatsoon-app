{
  "expo": {
    "name": "Chatsoon",
    "slug": "chatsoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatsoon",
    "userInterfaceStyle": "automatic",
    "description": "Meet people. Follow up.",
    "ios": {
      "bundleIdentifier": "app.chatsoon",
      "buildNumber": "1",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:chatsoon.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes and photograph business cards",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.chatsoon",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#5146E5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "chatsoon.app",
              "pathPrefix": "/id/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Chatsoon",
      "shortName": "Chatsoon",
      "description": "Scan a card, share your QR, and let AI turn every hello into a relationship worth keeping.",
      "themeColor": "#5146E5",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5146E5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan QR codes and photograph business cards",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Used to scan QR codes and photograph business cards",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56432523-112e-472e-9ecc-bdfacbb6b023"
      }
    },
    "owner": "moshiconcepts"
  }
}
