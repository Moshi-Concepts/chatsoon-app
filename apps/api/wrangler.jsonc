{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "chatsoon-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.chatsoon.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatsoon",
      // Replace with the id printed by `wrangler d1 create chatsoon`.
      "database_id": "4b2dea2c-b411-4501-aee3-e09bdfe362f0",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "chatsoon-files" }],
  // The card renderer (apps/og). Missing (or OG_CARDS_ENABLED "false" below) falls back to the
  // default share image with no code change (docs/og-plan.md O8, O20).
  "services": [{ "binding": "OG", "service": "chatsoon-og", "entrypoint": "OgRenderer" }],
  "ratelimits": [
    { "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Global per-IP cap across every slug (D24): findable profiles plus auto-accept make harvesting
    // cheaper, so this catches a burst spread across many profiles that the per-slug limiter misses.
    { "name": "CONNECT_ANY_LIMITER", "namespace_id": "1011", "simple": { "limit": 30, "period": 60 } },
    // Per email address. Per IP is looser because a whole conference venue can share one IP.
    { "name": "OTP_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // Checking codes, per IP.
    { "name": "OTP_IP_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
    // Sending codes, per IP. Tighter than checking: every send is a real email to any address.
    { "name": "OTP_SEND_IP_LIMITER", "namespace_id": "1008", "simple": { "limit": 10, "period": 60 } },
    { "name": "SCAN_LIMITER", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    // The app uploads one compressed photo per avatar or card.
    { "name": "UPLOAD_LIMITER", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } },
    { "name": "EXTRACT_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    // Per user, on writes that add rows (contacts, tags, events). Room for the offline outbox to sync.
    { "name": "WRITE_LIMITER", "namespace_id": "1009", "simple": { "limit": 120, "period": 60 } },
    // Per IP, on profile lookups that find nothing, so slugs can't be guessed in bulk.
    { "name": "PROFILE_MISS_LIMITER", "namespace_id": "1010", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "WEB_ORIGIN": "https://chatsoon.app",
    "API_ORIGIN": "https://api.chatsoon.app",
    // Extra CORS origins, comma separated (dev servers). Empty in production.
    "EXTRA_ORIGINS": "",
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "Chatsoon <hello@updates.chatsoon.app>",
    "REPORTS_NOTIFY_EMAIL": "hello@chatsoon.app",
    // "true" lets review@chatsoon.app sign in with REVIEWER_CODE (secret).
    "REVIEWER_ENABLED": "true",
    // Comma separated emails of removed users. They can't request or use a sign-in code.
    "BANNED_EMAILS": "",
    "EXTRACT_MODEL": "claude-haiku-4-5",
    // Spend caps for Claude card extraction. "false" is the kill switch.
    "EXTRACT_ENABLED": "true",
    "EXTRACT_DAILY_PER_USER": "30",
    "EXTRACT_DAILY_TOTAL": "1000",
    // "false" is the kill switch (and the Free-plan setting): profiles fall back to the default image.
    "OG_CARDS_ENABLED": "true"
  }
  // Secrets (wrangler secret put <NAME>):
  //   BETTER_AUTH_SECRET  RESEND_API_KEY  ANTHROPIC_API_KEY
  //   TURNSTILE_SECRET    FILE_SIGNING_SECRET  REVIEWER_CODE  PAGES_SHARED_SECRET
}
