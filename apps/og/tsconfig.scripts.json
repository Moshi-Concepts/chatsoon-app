{
  // scripts/ runs under Node (tsx), not workerd — its own config so `fs`/`Buffer`/`WebAssembly` resolve
  // to Node's real types instead of the Workers-runtime subset tsconfig.json's "types" pulls in for
  // src/ and test/ (they'd otherwise collide: e.g. workers-types' `Buffer` has no `toString(encoding)`
  // overload, and no `WebAssembly.compile`). `apps/og/package.json`'s "typecheck" runs both configs.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["scripts"]
}
