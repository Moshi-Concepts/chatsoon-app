{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chatsoon/api",
        "run",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "api-logmail",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chatsoon/api",
        "exec",
        "wrangler",
        "dev",
        "--var",
        "EMAIL_PROVIDER:log",
        "--port",
        "8789"
      ],
      "port": 8789
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chatsoon/mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-static",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@chatsoon/web",
        "exec",
        "wrangler",
        "pages",
        "dev",
        "dist",
        "--port",
        "8788"
      ],
      "port": 8788
    }
  ]
}